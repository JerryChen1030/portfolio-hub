---
interface Props {
  href: string;
  title: string;
  description: string;
}

const { href, title, description } = Astro.props;
---

<article class="project-card">
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
</article>

<style>
  .project-card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
  .project-card h3 { margin: 0 0 0.4rem; font-size: 1.1rem; }
  .project-card p { margin: 0; color: var(--muted); }
</style>
