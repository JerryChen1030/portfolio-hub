---
import { siteConfig } from '../site.config';
---

<section class="hero">
  <h1>{siteConfig.name}</h1>
  <p class="tagline">{siteConfig.tagline}</p>
  <div class="cta">
    <a class="btn primary" href="/work">看作品</a>
    <a class="btn" href="/reading">看閱讀筆記</a>
  </div>
</section>

<style>
  .hero {
    padding: 2rem 0 2.5rem;
    text-align: center;
  }
  .hero h1 { font-size: 2rem; margin: 0 0 0.4rem; }
  .tagline { color: var(--muted); margin: 0 0 1.5rem; }
  .cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .btn {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border-radius: 0.4rem;
    border: 1px solid var(--accent);
    text-decoration: none;
    color: var(--accent);
    font-size: 0.9rem;
  }
  .btn.primary {
    background: var(--accent);
    color: #fff;
  }
</style>
